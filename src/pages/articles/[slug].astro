---
import { getCollection } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import rehypeSponsored from '../../../rehype-sponsored.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { SITE, CATEGORY_NAMES, slugOf } from '../../data/site';
import { factsOf } from '../../data/services';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({ params: { slug: slugOf(article.id) }, props: { article } }));
}

const { article } = Astro.props;
const { data } = article;

// S04再構築（2026-11-25）：特典定義ボックス・運営コードボックスは事実の正
// （src/data/services.ts 経由の services-data.json 同期コピー）から描画する。
// 正に無いサービスがあれば frontmatter にフォールバックする。
const slug = slugOf(article.id);
const facts = factsOf(slug);
const benefit = facts?.benefit ?? data.benefit;
const code = facts ? facts.code : (data.code ?? null);
const friendCode = facts?.friendCode ?? null;
const url = facts ? facts.url : (data.url ?? null);
const officialSite = facts ? facts.officialSite : (data.officialSite ?? null);
const conditionsList = facts ? facts.conditions : (data.conditions ? [data.conditions] : []);
const deadline = facts?.deadline ?? null;
const verified = facts?.verified;
const codeLabel = slug === 'dips' ? 'メア特別コード（インフルエンサーコード）' : '紹介コード';
const IMG_DIMS: Record<string, [number, number]> = {"/images/banner-freecash.jpg": [2400, 800], "/images/banner-muse.jpg": [2400, 800], "/images/banner-hapitas.jpg": [561, 129], "/images/banner-moppy.jpg": [234, 60], "/images/banner-warau.jpg": [234, 60], "/images/hero.jpg": [1179, 393], "https://mea-poikatsu.github.io/mea-poikatsu-blog/images/banner-rakuten.jpg": [2400, 800], "https://mea-poikatsu.github.io/mea-poikatsu-blog/images/banner-tiktok.jpg": [2400, 800], "https://mea-poikatsu.github.io/mea-poikatsu-blog/images/banner-freecash.jpg": [2400, 800], "/images/banner-orikuji.jpg": [2400, 800], "/images/banner-pokekatsu.jpg": [2400, 800], "/images/banner-tiktok-lite.jpg": [2400, 800], "/images/banner-paypay.jpg": [2400, 800], "/images/banner-airwallet.jpg": [2400, 800], "/images/banner-olive.jpg": [2400, 800], "/images/banner-sampo.jpg": [2400, 800], "/images/banner-butamaru.jpg": [2400, 800], "/images/banner-mirapoi.jpg": [2400, 800], "/images/banner-tokueru.jpg": [2400, 800], "/images/banner-dips.jpg": [2400, 800]};
const imgSize = data.image ? IMG_DIMS[data.image] : undefined;

// 記事本文の中段に忍者AdMaxの中段枠（position="middle"）を差し込む（2026-11-21 ユーザー決定）。
// 本文Markdown自体は変更せず、「## 」見出しセクションの半分を過ぎた最初の見出しの直前で分割して描画する。
const mdProcessor = await createMarkdownProcessor({ rehypePlugins: [rehypeSponsored] });
const bodyLines = (article.body ?? '').split('\n');
const headingLineIdxs = bodyLines.map((l, i) => (l.startsWith('## ') ? i : -1)).filter((i) => i >= 0);
let bodyFirst = article.body ?? '';
let bodyRest = '';
if (headingLineIdxs.length >= 2) {
  const cut = headingLineIdxs[Math.floor(headingLineIdxs.length / 2)];
  bodyFirst = bodyLines.slice(0, cut).join('\n');
  bodyRest = bodyLines.slice(cut).join('\n');
}
const firstHtml = (await mdProcessor.render(bodyFirst)).code;
const restHtml = bodyRest ? (await mdProcessor.render(bodyRest)).code : '';

const BOARD_SLUG_MAP: Record<string, string> = {
  freecash: 'freecash', warau: 'warau', hapitas: 'hapitas', moppy: 'moppy',
  tiktok: 'tiktok', 'tiktok-lite': 'tiktok-lite', orikuji: 'orikuji', pokekatsu: 'pokekatsu',
  muse: 'muse', sampo: 'sampo', butamaru: 'butamaru', mirapoi: 'mirapoi',
  tokueru: 'tokueru', dips: 'dips', mercari: 'mercari', paypay: 'paypay',
  airwallet: 'airwallet', 'rakuten-mobile': 'rakuten-mobile', olive: 'smbc-olive',
};
const all = await getCollection('articles');
const related = all.filter((a) => a.data.category === data.category && a.id !== article.id);
const others = all.filter((a) => a.data.category !== data.category && a.id !== article.id).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: data.title,
      description: data.description,
      inLanguage: 'ja',
      author: { '@type': 'Person', name: SITE.operator },
      dateModified: data.dateModified,
      mainEntityOfPage: `${SITE.siteUrl}/articles/${slugOf(article.id)}/`,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'コードサーチ トップ', item: SITE.siteUrl + '/' },
        { '@type': 'ListItem', position: 2, name: CATEGORY_NAMES[data.category] ?? data.category, item: `${SITE.siteUrl}/categories/${data.category}/` },
        { '@type': 'ListItem', position: 3, name: data.service, item: `${SITE.siteUrl}/articles/${slugOf(article.id)}/` },
      ],
    },
  ],
};
---

<BaseLayout title={`${data.title}｜${SITE.name}`} description={data.description} canonicalPath={`/articles/${slugOf(article.id)}/`} ogImage={data.image ?? '/images/hero.jpg'} jsonLd={jsonLd}>
  <div class="wrap article-body">
    <p class="breadcrumb"><a href="/mea-code-search/">トップ</a> › <a href={`/mea-code-search/categories/${data.category}/`}>{CATEGORY_NAMES[data.category] ?? data.category}</a> › {data.service}</p>

    <h1>{data.title}</h1>
    <p class="article-meta">最終更新：{data.dateModified}{data.verified ? `｜最終確認日：${data.verified}（公式情報）` : ''}｜運営者：{SITE.operator}</p>
    <p class="article-pr">PR｜この記事には紹介リンク・紹介コードを含みます。条件を満たすと紹介者に報酬が支払われる場合があります（利用する方の特典は減りません）。</p>

    <AdSlot position="top" />

    {data.image && (
      <img class="banner-img" src={data.image.startsWith('http') ? data.image : '/mea-code-search' + data.image} alt={data.imageAlt ?? `${data.service}の紹介バナー`} width={imgSize?.[0]} height={imgSize?.[1]} />
    )}
    <p class="lead">{data.description}</p>

    <section class="benefit-def" aria-label="特典の定義">
      <h2 class="benefit-def-title">特典の定義｜招待された側がもらえるもの</h2>
      <div class="benefit-def-body">
        <p class="benefit-def-value"><span class="benefit-def-label">特典</span><strong>{benefit}</strong></p>
        {conditionsList.length > 0 && (
          <div class="benefit-def-row">
            <p class="benefit-def-label">条件</p>
            <ul class="benefit-def-conditions">
              {conditionsList.map((c) => <li>{c}</li>)}
            </ul>
          </div>
        )}
        {deadline && <p class="benefit-def-deadline"><span class="benefit-def-label">期限・期間</span>{deadline}</p>}
        {verified && <p class="benefit-def-verified">最終確認日：{verified}（公式情報）</p>}
      </div>
    </section>

    <section class="code-box" aria-label="紹介コード">
      <h2 class="code-box-title">メアの紹介コード</h2>
      {code ? (
        <>
          <p class="code-box-label">{codeLabel}</p>
          <div class="code-row code-row-big">
            <code>{code}</code>
            <button class="copy-btn" type="button" data-copy={code} data-service={slug}>
              <span class="copy-label">コピー</span>
            </button>
          </div>
          {friendCode && (
            <>
              <p class="code-box-label">友達招待コード（両方入力でお得）</p>
              <div class="code-row code-row-big">
                <code>{friendCode}</code>
                <button class="copy-btn" type="button" data-copy={friendCode} data-service={slug}>
                  <span class="copy-label">コピー</span>
                </button>
              </div>
            </>
          )}
        </>
      ) : (
        <p class="conditions">紹介コードはありません。紹介リンクから登録してください。</p>
      )}
      {url ? (
        <a class="register-btn" href={url} target="_blank" rel="sponsored noopener" data-service={slug} data-position="article_top" data-ref-service={slug} data-ref-placement="article_top">
          無料で登録する
        </a>
      ) : officialSite ? (
        <a class="register-btn" href={officialSite} target="_blank" rel="noopener" data-service={slug} data-position="article_top">
          公式サイトを見る
        </a>
      ) : (
        <p class="conditions">※{data.service}は招待コードのみの紹介です。アプリ・サイト内でコードを入力してください。</p>
      )}
      {data.points && (
        <ul class="points">
          {data.points.map((p) => <li>{p}</li>)}
        </ul>
      )}
      {data.prNote && <p class="pr-note">{data.prNote}</p>}
    </section>

    <div class="article-extra" set:html={firstHtml} />

    {restHtml && <AdSlot position="middle" />}

    {restHtml && <div class="article-extra" set:html={restHtml} />}

    <section class="article-end-cta">
      <h2>{data.service}の特典と紹介コード</h2>
      <div class="benefit-badge">
        <span class="benefit-label">登録者特典</span>
        <span class="benefit-value">{benefit}</span>
      </div>
      {code ? (
        <>
          <div class="code-row">
            <code>{code}</code>
            <button class="copy-btn" type="button" data-copy={code} data-service={slug}>
              <span class="copy-label">コピー</span>
            </button>
          </div>
          {friendCode && (
            <div class="code-row">
              <code>{friendCode}</code>
              <button class="copy-btn" type="button" data-copy={friendCode} data-service={slug}>
                <span class="copy-label">コピー</span>
              </button>
            </div>
          )}
        </>
      ) : (
        <p class="conditions">紹介コードはありません。紹介リンクから登録してください。</p>
      )}
      <p class="conditions">条件・期限は上の「特典の定義」で確認してから登録してください。</p>
      {url ? (
        <a class="register-btn" href={url} target="_blank" rel="sponsored noopener" data-service={slug} data-position="article_bottom" data-ref-service={slug} data-ref-placement="article_bottom">
          無料で登録する
        </a>
      ) : officialSite ? (
        <a class="register-btn" href={officialSite} target="_blank" rel="noopener" data-service={slug} data-position="article_bottom">
          公式サイトを見る
        </a>
      ) : (
        <p class="conditions">※{data.service}は招待コードのみの紹介です。アプリ・サイト内でコードを入力してください。</p>
      )}
      {BOARD_SLUG_MAP[slug] && (
        <p><a href={`https://mea-poikatsu.github.io/mea-keijiban/service/${BOARD_SLUG_MAP[slug]}/`} target="_blank" rel="noopener">みんなのコードも見る（掲示板）</a></p>
      )}
    </section>

    <AdSlot position="bottom" />

    <section class="related">
      <h2>関連記事｜{CATEGORY_NAMES[data.category] ?? data.category}の紹介コード</h2>
      <div class="card-grid">
        {related.map((a) => <ServiceCard article={a} />)}
      </div>
      <h3>ほかのサービスも見る</h3>
      <ul>
        {others.map((a) => (
          <li><a href={`/mea-code-search/articles/${slugOf(a.id)}/`}>{a.data.service}の紹介コード {a.data.code ?? ''}</a>（{a.data.benefit}）</li>
        ))}
      </ul>
      <p><a href="/mea-code-search/">紹介コード一覧トップへ戻る →</a></p>
    </section>
  </div>
</BaseLayout>
