---
// S04再構築（2026-11-25）：トップページの「サービス別ページへの入口」リスト項目。
// 一覧で完結させず、各サービスの個別ページへ送るのが役割。
// 表示する特典・コードは事実の正（src/data/services.ts 経由の services-data.json 同期コピー）から出す。
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_NAMES, slugOf } from '../data/site';
import { factsOf } from '../data/services';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { data } = article;
const slug = slugOf(article.id);
const facts = factsOf(slug);
const articleUrl = `/mea-code-search/articles/${slug}/`;
const benefit = facts?.benefit ?? data.benefit;
const code = facts ? facts.code : (data.code ?? null);
const hasUrl = facts ? !!facts.url : !!data.url;
const codeState = code ? 'code' : hasUrl ? 'link' : 'codeonly';
const codeStateLabel = codeState === 'code' ? 'コードあり' : codeState === 'link' ? 'リンク型（コードなし）' : 'コードのみ';
const searchText = `${data.service} ${code ?? ''} ${benefit} ${data.title} ${data.description}`.toLowerCase();
---

<article class="service-entry" data-category={data.category} data-service={data.service} data-sort-yen={data.sortYen ?? 0} data-search={searchText}>
  <a class="entry-main" href={articleUrl}>
    <div class="entry-head">
      <h3>{data.service}</h3>
      <span class={`entry-state entry-state-${codeState}`}>{codeStateLabel}</span>
    </div>
    <p class="entry-benefit"><span class="entry-benefit-label">特典</span>{benefit}</p>
    {code && <p class="entry-code">紹介コード：<code>{code}</code></p>}
    <div class="entry-foot">
      <span class="card-tag">{CATEGORY_NAMES[data.category] ?? data.category}</span>
      {data.badge && <span class="card-tag card-tag-accent">{data.badge}</span>}
      <span class="entry-more">コードと条件を見る ›</span>
    </div>
  </a>
</article>
